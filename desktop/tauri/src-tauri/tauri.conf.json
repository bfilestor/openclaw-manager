{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenClaw Manager",
  "version": "0.1.0",
  "identifier": "ai.openclaw.manager.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": ".."
  },
  "app": {
    "windows": [
      {
        "title": "OpenClaw Manager",
        "width": 1360,
        "height": 900,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg"],
    "resources": [
      "resources/managerd",
      "resources/managerd.exe",
      "resources/config.template.toml"
    ]
  }
}
